---
import technologies from "../data/technologies.json";
---

<section id="about" class="relative py-12 md:py-14">
    <div aria-hidden="true" class="pointer-events-none absolute -left-16 top-10 h-48 w-48 rounded-full bg-primary/15 blur-3xl"></div>
    <div class="grid items-start gap-6 md:grid-cols-[1.1fr_0.9fr] md:gap-10">
        <div class="space-y-6 reveal">
            <!-- <p class="kicker inline-flex items-center gap-2 rounded-sm border border-border bg-surface px-3 py-1">
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                DISPONIBLE
            </p> -->

            <h1 class="max-w-4xl text-[2rem] leading-[0.94] text-text sm:text-[2.35rem] md:text-[4.8rem] md:leading-[0.84]">
                PROGRAMADOR FREELANCE
                <br />
                DE <span class="display-outline">APPS Y WEB</span>
                <br />
                PARA EMPRESAS QUE QUIEREN ESCALAR
            </h1>

            <p class="max-w-2xl text-sm leading-relaxed text-textMuted sm:text-base md:text-lg reveal reveal-2">
                Soy Álvaro Campos, programador freelance especializado en aplicaciones moviles, plataformas web y productos SaaS. Trabajo con empresas de Reus, Tarragona, toda España y clientes internacionales en remoto.
            </p>

            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap reveal reveal-3">
                <a href="#contact" class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-primary px-5 py-3 text-sm font-semibold uppercase tracking-[0.05em] text-white hover:bg-primaryStrong sm:w-auto">
                    Solicitar presupuesto
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                </a>
                <a href="/CV.pdf" download class="inline-flex w-full items-center justify-center gap-2 rounded-sm border border-border bg-surface px-5 py-3 text-sm font-semibold uppercase tracking-[0.05em] text-textStrong hover:border-primary hover:bg-surfaceAlt sm:w-auto">
                    Ver CV
                    <i class="fa-solid fa-file-arrow-down text-xs"></i>
                </a>
            </div>

            <div class="grid gap-2.5 sm:grid-cols-3">
                <div class="rounded-sm border border-borderSoft bg-surface p-3.5">
                    <p class="kicker">estrategia</p>
                      <p class="mt-1 text-sm font-semibold uppercase tracking-[0.05em] text-text">Apps + Producto Digital</p>
                </div>
                <div class="rounded-sm border border-borderSoft bg-surface p-3.5">
                    <p class="kicker">base</p>
                    <p class="mt-1 text-sm font-semibold uppercase tracking-[0.05em] text-text">Reus + Remoto</p>
                </div>
                <div class="rounded-sm border border-borderSoft bg-surface p-3.5">
                    <p class="kicker">servicios</p>
                    <p class="mt-1 text-sm font-semibold uppercase tracking-[0.05em] text-text">Apps, Web, SaaS, Ecommerce</p>
                </div>
            </div>
        </div>

        <div class="space-y-3 reveal reveal-2">
            <figure class="relative overflow-hidden rounded-sm border border-border bg-surface">
                <img src="/foto_perfil.png" alt="Alvaro Campos, programador freelance de apps en Reus" class="h-[340px] w-full object-cover object-right-top sm:h-[420px] md:h-[500px]" />
                <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-bgDeep via-bgDeep/80 to-transparent p-5">
                    <p class="text-base font-semibold text-text">Alvaro Campos</p>
                    <p class="text-sm uppercase tracking-[0.07em] text-textSoft">Programador Freelance APP</p>
                </figcaption>
            </figure>

            <div class="section-wrap rounded-sm">
                <p class="kicker mb-3">Tech Stack</p>
                <div class="flex flex-wrap gap-2">
                    {technologies.map((tech) => (
                        <div class="flex items-center gap-2 rounded-sm border border-borderSoft bg-surfaceAlt px-3 py-1 text-xs font-medium uppercase tracking-[0.05em] text-textMuted">
                            <img src={tech.icon} class="h-4" alt={tech.name} />
                            <span>{tech.name}</span>
                        </div>
                    ))}
                </div>
            </div>

            <div class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
                <a href="https://www.linkedin.com/in/álvaro-campos-sánchez-4aabb6288/" target="_blank" class="inline-flex items-center justify-center gap-2 rounded-sm border border-border bg-surface px-3 py-2 font-semibold uppercase tracking-[0.04em] text-textMuted hover:border-primary hover:text-text hover:bg-surfaceAlt" title="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                    LinkedIn
                </a>
                <a href="https://github.com/alvarocampossanchez14/" target="_blank" class="inline-flex items-center justify-center gap-2 rounded-sm border border-border bg-surface px-3 py-2 font-semibold uppercase tracking-[0.04em] text-textMuted hover:border-primary hover:text-text hover:bg-surfaceAlt" title="GitHub">
                    <i class="fa-brands fa-github"></i>
                    GitHub
                </a>
            </div>
        </div>
    </div>
</section>
